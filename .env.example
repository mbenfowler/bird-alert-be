# Postgres connection strings (knexfile picks by NODE_ENV)
DEV_PG_URL=postgres://user@localhost:5432/birdalert
PROD_PG_URL=
# Used by `npm test` for the database-backed tests (migrations run against it; tables are emptied).
TEST_PG_URL=postgres://user@localhost:5432/birdalert_test

# Random string, at least 32 chars. Signs session cookies and email links.
SESSION_SECRET=

# Where the front end lives; used to build links in emails.
APP_BASE_URL=http://localhost:3000

# Required in production. Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to cron routes.
CRON_SECRET=

# eBird API key: species lists, observations, taxonomy, and the daily digest.
EBIRD_API_KEY=

# Nuthatch API key for bird images (https://nuthatch.lastelm.software). Optional; birds get no image without it.
NUTHATCH_API_KEY=

# Gmail account and app password (Google Account > Security > App passwords) for nodemailer.
# Email is only sent in production or with FORCE_SEND_MAIL=true.
APP_EMAIL=
APP_PW=
FORCE_SEND_MAIL=false

# Web push. Generate with `npx web-push generate-vapid-keys`. The public key is sent to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# xeno-canto API key (free with a verified xeno-canto account) for bird sounds. Optional; /api/sound answers 503 without it.
XENO_CANTO_KEY=

# Optional: any provider's SMTP, replacing Gmail (e.g. smtps://user:pass@smtp.provider.com:465).
SMTP_URL=
# Optional: emails per UTC day before sending stops (default 450 with Gmail, unlimited with SMTP_URL).
# Digests stop at 85% of it so confirmation and reset emails always get through.
MAIL_DAILY_CAP=
