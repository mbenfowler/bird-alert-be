# Postgres connection strings (knexfile picks by NODE_ENV)
DEV_PG_URL=postgres://user@localhost:5432/birdalert
PROD_PG_URL=

# Random string, at least 32 chars. Signs session cookies and email links.
SESSION_SECRET=

# Where the front end lives; used to build links in emails.
APP_BASE_URL=http://localhost:3000

# Required in production. Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to cron routes.
CRON_SECRET=

# eBird API key: species lists, observations, taxonomy, and the daily digest.
EBIRD_API_KEY=

# Nuthatch API key for bird images (https://nuthatch.lastelm.software). Optional; birds get no image without it.
NUTHATCH_API_KEY=

# Gmail OAuth2 credentials for nodemailer. Email is only sent in production or with FORCE_SEND_MAIL=true.
APP_EMAIL=
APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_REFRESH_TOKEN=
FORCE_SEND_MAIL=false
