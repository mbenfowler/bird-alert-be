{
  "rewrites": [
    {
      "source": "/api/alertDigestMailer",
      "destination": "/api/mail/watchlist"
    },
    {
      "source": "/api/rareSightingsMailer",
      "destination": "/api/mail/rare"
    },
    {
      "source": "/api/migrationMailer",
      "destination": "/api/mail/migration"
    },
    {
      "source": "/api/mailPreview",
      "destination": "/api/mail/preview"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@jimp/plugin-print/dist/fonts/open-sans/{open-sans-10-black,open-sans-16-white}/**"
    }
  }
}
